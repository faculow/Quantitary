@model Quantitary.Models.AjustesViewModel
@{
    ViewData["Title"] = "Ajustes";
    var iniciales = string.Concat((Model.Perfil.NombreUsuario ?? "U")
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(p => char.ToUpperInvariant(p[0])));
}

<div class="settings-page" data-active-section="@Model.SeccionActiva">
    <header class="settings-title">
        <div>
            <p class="eyebrow">Tu cuenta</p>
            <h1>Ajustes</h1>
            <p>Personalizá tu cuenta y tu empresa.</p>
        </div>
    </header>

    @if (TempData["AjustesExito"] is string mensaje)
    {
        <div class="settings-alert success" role="status">
            <span aria-hidden="true">✓</span>
            <span>@mensaje</span>
        </div>
    }

    <div class="settings-layout">
        <nav class="settings-nav" aria-label="Secciones de ajustes">
            <button type="button" class="settings-nav-item" data-settings-target="perfil">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"></path></svg>
                <span>Perfil</span>
            </button>
            <button type="button" class="settings-nav-item" data-settings-target="empresa">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 21V5l8-3 8 3v16M8 9h2m4 0h2M8 13h2m4 0h2M9 21v-4h6v4"></path></svg>
                <span>Empresa</span>
            </button>
            <button type="button" class="settings-nav-item" data-settings-target="notificaciones">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 8h18c0-1-3-1-3-8M10 21h4"></path></svg>
                <span>Notificaciones</span>
            </button>
            <button type="button" class="settings-nav-item" data-settings-target="apariencia">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
                <span>Apariencia</span>
            </button>
            <button type="button" class="settings-nav-item" data-settings-target="seguridad">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2 4 5v6c0 5.2 3.4 9.3 8 11 4.6-1.7 8-5.8 8-11V5zM9 12l2 2 4-5"></path></svg>
                <span>Seguridad</span>
            </button>
        </nav>

        <div class="settings-panels">
            <section class="settings-panel" data-settings-panel="perfil" aria-labelledby="perfil-title">
                <div class="settings-panel-heading">
                    <div>
                        <h2 id="perfil-title">Datos personales</h2>
                        <p>Información asociada a tu cuenta.</p>
                    </div>
                </div>

                <form asp-controller="Ajustes" asp-action="GuardarPerfil" method="post">
                    <div class="profile-settings-grid">
                        <div class="profile-avatar-column">
                            <div class="settings-avatar" aria-hidden="true">@iniciales</div>
                            <small>Tu avatar usa las iniciales del nombre.</small>
                        </div>
                        <div class="settings-form-grid">
                            <div class="settings-field full">
                                <label asp-for="Perfil.NombreUsuario">Nombre de usuario</label>
                                <input asp-for="Perfil.NombreUsuario" class="form-control" autocomplete="name" />
                                <span asp-validation-for="Perfil.NombreUsuario" class="field-error"></span>
                            </div>
                            <div class="settings-field full">
                                <label asp-for="Perfil.Mail">Correo electrónico</label>
                                <input asp-for="Perfil.Mail" type="email" class="form-control" autocomplete="email" />
                                <span asp-validation-for="Perfil.Mail" class="field-error"></span>
                            </div>
                            <div class="settings-field full">
                                <label asp-for="Perfil.NumeroTelefono">Teléfono</label>
                                <input asp-for="Perfil.NumeroTelefono" class="form-control" autocomplete="tel" placeholder="Opcional" />
                                <span asp-validation-for="Perfil.NumeroTelefono" class="field-error"></span>
                            </div>
                        </div>
                    </div>
                    <div class="settings-actions">
                        <button type="submit" class="btn btn-primary">Guardar cambios</button>
                    </div>
                </form>
            </section>

            <section class="settings-panel" data-settings-panel="empresa" aria-labelledby="empresa-title" hidden>
                <div class="settings-panel-heading">
                    <div>
                        <h2 id="empresa-title">Datos de la empresa</h2>
                        <p>Este nombre se muestra en el panel y en los datos compartidos por tu equipo.</p>
                    </div>
                </div>

                @if (Model.PuedeEditarEmpresa)
                {
                    <form asp-controller="Ajustes" asp-action="GuardarEmpresa" method="post">
                        <div class="settings-form-grid">
                            <div class="settings-field full">
                                <label asp-for="Empresa.Nombre">Nombre de la empresa</label>
                                <input asp-for="Empresa.Nombre" class="form-control" autocomplete="organization" />
                                <span asp-validation-for="Empresa.Nombre" class="field-error"></span>
                            </div>
                        </div>
                        <div class="settings-actions">
                            <button type="submit" class="btn btn-primary">Guardar cambios</button>
                        </div>
                    </form>
                }
                else
                {
                    <div class="settings-readonly">
                        <span>Empresa actual</span>
                        <strong>@Model.Empresa.Nombre</strong>
                        <small>Solo un administrador puede modificar estos datos.</small>
                    </div>
                }
            </section>

            <section class="settings-panel" data-settings-panel="notificaciones" aria-labelledby="notificaciones-title" hidden>
                <div class="settings-panel-heading">
                    <div>
                        <h2 id="notificaciones-title">Notificaciones</h2>
                        <p>Elegí los avisos que querés ver en este dispositivo.</p>
                    </div>
                </div>
                <div class="settings-option-list">
                    <label class="settings-option">
                        <span><strong>Alertas de stock bajo</strong><small>Avisarme cuando haya productos por debajo del mínimo.</small></span>
                        <input type="checkbox" class="settings-switch" data-preference="notifyStock" checked />
                    </label>
                </div>
                <div class="settings-actions">
                    <span class="settings-inline-success" id="notificationsSaved" role="status" hidden>✓ Preferencias guardadas</span>
                    <button type="button" class="btn btn-primary" id="saveNotifications">Guardar preferencias</button>
                </div>
            </section>

            <section class="settings-panel" data-settings-panel="apariencia" aria-labelledby="apariencia-title" hidden>
                <div class="settings-panel-heading">
                    <div>
                        <h2 id="apariencia-title">Apariencia</h2>
                        <p>Configurá cómo querés ver Quantitary en este dispositivo.</p>
                    </div>
                </div>
                <div class="settings-form-grid">
                    <div class="settings-field">
                        <label for="themePreference">Tema</label>
                        <select id="themePreference" class="form-control">
                            <option value="system">Usar configuración del dispositivo</option>
                            <option value="light">Claro</option>
                            <option value="dark">Oscuro</option>
                        </select>
                    </div>
                    <div class="settings-field">
                        <label for="densityPreference">Densidad de pantalla</label>
                        <select id="densityPreference" class="form-control">
                            <option value="comfortable">Cómoda</option>
                            <option value="compact">Compacta</option>
                        </select>
                    </div>
                </div>
                <div class="appearance-preview" aria-hidden="true">
                    <span></span><span></span><span></span>
                </div>
                <div class="settings-actions">
                    <span class="settings-inline-success" id="appearanceSaved" role="status" hidden>✓ Apariencia guardada</span>
                    <button type="button" class="btn btn-primary" id="saveAppearance">Aplicar cambios</button>
                </div>
            </section>

            <section class="settings-panel" data-settings-panel="seguridad" aria-labelledby="seguridad-title" hidden>
                <div class="settings-panel-heading">
                    <div>
                        <h2 id="seguridad-title">Seguridad</h2>
                        <p>Cambiá tu contraseña de acceso.</p>
                    </div>
                </div>
                <form asp-controller="Ajustes" asp-action="CambiarContrasena" method="post">
                    <div class="settings-form-grid">
                        <div class="settings-field full">
                            <label asp-for="Seguridad.ContrasenaActual">Contraseña actual</label>
                            <input name="Seguridad.ContrasenaActual" id="Seguridad_ContrasenaActual" type="password" class="form-control" autocomplete="current-password" />
                            <span asp-validation-for="Seguridad.ContrasenaActual" class="field-error"></span>
                        </div>
                        <div class="settings-field">
                            <label asp-for="Seguridad.ContrasenaNueva">Nueva contraseña</label>
                            <input name="Seguridad.ContrasenaNueva" id="Seguridad_ContrasenaNueva" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Seguridad.ContrasenaNueva" class="field-error"></span>
                        </div>
                        <div class="settings-field">
                            <label asp-for="Seguridad.Confirmacion">Repetir contraseña</label>
                            <input name="Seguridad.Confirmacion" id="Seguridad_Confirmacion" type="password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Seguridad.Confirmacion" class="field-error"></span>
                        </div>
                    </div>
                    <p class="password-help">Usá al menos 6 caracteres e incluí mayúsculas, minúsculas y números.</p>
                    <div class="settings-actions">
                        <button type="submit" class="btn btn-primary">Cambiar contraseña</button>
                    </div>
                </form>
            </section>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/ajustes.js" asp-append-version="true"></script>
}
