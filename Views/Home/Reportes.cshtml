@model Quantitary.Models.ReporteFormularioViewModel
@{
    ViewData["Title"] = "Reportes";
    var reportesGuardados = ViewBag.ReportesGuardados as List<Quantitary.Models.ReporteGuardado> ?? new List<Quantitary.Models.ReporteGuardado>();
    var totalReportes = ViewBag.TotalReportes as int? ?? reportesGuardados.Count;
    var resultadosReportes = ViewBag.ResultadosReportes as int? ?? reportesGuardados.Count;
    var busqueda = ViewBag.Busqueda as string;
    var tipoReporteFiltro = ViewBag.TipoReporteFiltro as string;
    var frecuenciaActualizacionFiltro = ViewBag.FrecuenciaActualizacionFiltro as string;
    var periodoTiempoFiltro = ViewBag.PeriodoTiempoFiltro as string;
    var fechaDesde = ViewBag.FechaDesde as DateTime?;
    var fechaHasta = ViewBag.FechaHasta as DateTime?;
    var exito = TempData["ReporteGuardadoExito"] as string;
    var cancelado = TempData["ReporteCancelado"] as string;

    var productosDisponibles = ViewBag.ProductosDisponibles as List<Quantitary.Models.Producto>;
    if (productosDisponibles == null)
    {
        productosDisponibles = new List<Quantitary.Models.Producto>();
    }

    var ultimoReporte = ViewBag.UltimoReporte as Quantitary.Models.ReporteGuardado;
}

<div class="panel quantitary-page reports-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 quantitary-page-header">
        <div>
            <h2 class="mb-1">Reportes</h2>
            <p class="text-muted mb-0">Creá y visualizá reportes del negocio.</p>
        </div>
        <a asp-controller="Home" asp-action="HistorialReportes" class="btn btn-outline-primary">
            Historial de reportes
        </a>
    </div>

    @if (!string.IsNullOrWhiteSpace(exito))
    {
        <div class="alert alert-success">@exito</div>
    }

    @if (!string.IsNullOrWhiteSpace(cancelado))
    {
        <div class="alert alert-warning">@cancelado</div>
    }

    <div class="row g-4">
        <div class="col-12">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Crear reporte</h5>

                    <form id="formCrearReporte" asp-controller="Home" asp-action="GuardarReporte" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label">Nombre del reporte</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Reporte de ventas semanal" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoReporte" class="form-label">Tipo de reporte</label>
                            <select asp-for="TipoReporte" class="form-select">
                                <option value="Ventas">Ventas</option>
                                <option value="Stock">Stock</option>
                                <option value="Productos">Productos</option>
                                <option value="Finanzas">Finanzas</option>
                            </select>
                            <span asp-validation-for="TipoReporte" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PeriodoTiempo" class="form-label">Período de tiempo</label>
                            <select asp-for="PeriodoTiempo" class="form-select">
                                <option value="Diario">Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual" selected>Mensual</option>
                                <option value="Trimestral">Trimestral</option>
                                <option value="Anual">Anual</option>
                            </select>
                            <span asp-validation-for="PeriodoTiempo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FormatoReporte" class="form-label">Formato del reporte</label>
                            <select asp-for="FormatoReporte" class="form-select">
                                <option value="PDF">PDF</option>
                                <option value="Excel">Excel</option>
                                <option value="CSV">CSV</option>
                                <option value="HTML">HTML</option>
                            </select>
                            <span asp-validation-for="FormatoReporte" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FrecuenciaActualizacion" class="form-label">Cada cuánto se actualiza</label>
                            <select asp-for="FrecuenciaActualizacion" class="form-select">
                                <option value="Manual">Manual</option>
                                <option value="Diario">Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                            <span asp-validation-for="FrecuenciaActualizacion" class="text-danger small"></span>
                        </div>

                        <div class="col-12" id="selectorProductosReporte">
                            <div class="d-flex justify-content-between align-items-end flex-wrap gap-2 mb-2">
                                <div>
                                    <label class="form-label mb-1">Productos a analizar</label>
                                    <div class="form-text mt-0">Seleccioná uno o más productos.</div>
                                </div>
                                <span id="cantidadProductosSeleccionados" class="badge text-bg-primary">0 seleccionados</span>
                            </div>

                            <div class="row g-2 mb-3">
                                <div class="col-md-7">
                                    <label for="buscarProductoReporte" class="form-label">Buscar producto</label>
                                    <input id="buscarProductoReporte" type="search" class="form-control" placeholder="Nombre o SKU" />
                                </div>
                                <div class="col-md-5">
                                    <label for="categoriaProductoReporte" class="form-label">Categoría</label>
                                    <select id="categoriaProductoReporte" class="form-select">
                                        <option value="">Todas</option>
                                        @foreach (var categoria in productosDisponibles.Select(producto => producto.Categoria).Where(categoria => !string.IsNullOrWhiteSpace(categoria)).Distinct().OrderBy(categoria => categoria))
                                        {
                                            <option value="@categoria">@categoria</option>
                                        }
                                    </select>
                                </div>
                            </div>

                            <div class="reporte-productos-grid" id="ProductosIds">
                                @foreach (var producto in productosDisponibles)
                                {
                                    var seleccionado = Model.ProductosIds != null && Model.ProductosIds.Contains(producto.Id);
                                    <label class="reporte-producto-card @(seleccionado ? "seleccionada" : "")"
                                           data-nombre="@producto.Nombre"
                                           data-sku="@producto.Sku"
                                           data-categoria="@producto.Categoria">
                                        <input class="reporte-producto-check" type="checkbox" name="ProductosIds" value="@producto.Id" checked="@seleccionado" />
                                        <span class="reporte-producto-top">
                                            <span class="product-sku">@producto.Sku</span>
                                            <span class="stock-badge @(producto.StockActual <= 0 ? "danger" : producto.StockActual < producto.StockMinimo ? "orange" : "ok")">
                                                @producto.StockActual uds.
                                            </span>
                                        </span>
                                        <strong class="reporte-producto-nombre">@producto.Nombre</strong>
                                        <span class="reporte-producto-info">Categoría: @(string.IsNullOrWhiteSpace(producto.Categoria) ? "Sin categoría" : producto.Categoria)</span>
                                        <span class="reporte-producto-precio">$@producto.Precio.ToString("N2")</span>
                                        <span class="reporte-producto-seleccion">@(seleccionado ? "Seleccionado" : "Seleccionar")</span>
                                    </label>
                                }
                            </div>

                            <span asp-validation-for="ProductosIds" class="text-danger small"></span>
                            <div class="form-text">El resumen y el detalle mostrarán únicamente los productos seleccionados.</div>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <button type="reset" class="btn btn-outline-secondary" onclick="setTimeout(actualizarSelectorProductos, 0)">Restablecer parámetros</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    @if (ultimoReporte != null)
    {
        <div class="d-flex justify-content-end gap-2 mt-3">
            <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#vistaPreviaReporteModal">
                Ver vista previa
            </button>
            <a asp-controller="Home" asp-action="DescargarReporte" asp-route-id="@ultimoReporte.Id" class="btn btn-success">Descargar</a>
        </div>

        <div class="modal fade" id="vistaPreviaReporteModal" tabindex="-1" aria-labelledby="vistaPreviaReporteTitulo" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="vistaPreviaReporteTitulo">Vista previa: @ultimoReporte.Nombre</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body bg-light">
                        @Html.Raw(ultimoReporte.VistaPreviaHtml)
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cerrar</button>
                        <a asp-controller="Home" asp-action="DescargarReporte" asp-route-id="@ultimoReporte.Id" class="btn btn-success">Descargar</a>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        const tipoReporte = document.querySelector('[name="TipoReporte"]');
        const selectorProductos = document.getElementById('selectorProductosReporte');
        const productosIds = document.querySelectorAll('.reporte-producto-check');
        const buscarProducto = document.getElementById('buscarProductoReporte');
        const categoriaProducto = document.getElementById('categoriaProductoReporte');
        const cantidadSeleccionados = document.getElementById('cantidadProductosSeleccionados');
        const formCrearReporte = document.getElementById('formCrearReporte');

        function actualizarSelectorProductos() {
            selectorProductos.style.display = tipoReporte?.value === 'Productos' ? '' : 'none';
        }

        function actualizarCantidadProductos() {
            const seleccionados = Array.from(productosIds).filter(check => check.checked).length;
            if (cantidadSeleccionados) {
                cantidadSeleccionados.textContent = `${seleccionados} seleccionado${seleccionados === 1 ? '' : 's'}`;
            }

            productosIds.forEach(check => {
                const tarjeta = check.closest('.reporte-producto-card');
                tarjeta?.classList.toggle('seleccionada', check.checked);
            });
        }

        function filtrarTarjetasProductos() {
            const texto = (buscarProducto?.value || '').trim().toLowerCase();
            const categoria = categoriaProducto?.value || '';

            document.querySelectorAll('.reporte-producto-card').forEach(tarjeta => {
                const coincideTexto = !texto
                    || (tarjeta.dataset.nombre || '').toLowerCase().includes(texto)
                    || (tarjeta.dataset.sku || '').toLowerCase().includes(texto);
                const coincideCategoria = !categoria
                    || (tarjeta.dataset.categoria || '') === categoria;
                tarjeta.style.display = coincideTexto && coincideCategoria ? '' : 'none';
            });
        }

        tipoReporte?.addEventListener('change', actualizarSelectorProductos);
        productosIds.forEach(check => check.addEventListener('change', actualizarCantidadProductos));
        buscarProducto?.addEventListener('input', filtrarTarjetasProductos);
        categoriaProducto?.addEventListener('change', filtrarTarjetasProductos);
        formCrearReporte?.addEventListener('submit', function (evento) {
            const cantidadSeleccionada = Array.from(productosIds).filter(check => check.checked).length;
            if (tipoReporte?.value === 'Productos' && cantidadSeleccionada === 0) {
                evento.preventDefault();
                alert('Seleccioná al menos un producto para generar el reporte.');
                productosIds[0]?.focus();
            }
        });
        actualizarSelectorProductos();
        actualizarCantidadProductos();

        const reporteGuardado = @Html.Raw(Json.Serialize(!string.IsNullOrWhiteSpace(exito)));
        const modalVistaPrevia = document.getElementById('vistaPreviaReporteModal');

        if (reporteGuardado && modalVistaPrevia && window.bootstrap) {
            const modal = new bootstrap.Modal(modalVistaPrevia);
            modal.show();
        }
    </script>
}
