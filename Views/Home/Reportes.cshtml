@model Quantitary.Models.ReporteFormularioViewModel
@{
    ViewData["Title"] = "Reportes";
    var reportesGuardados = ViewBag.ReportesGuardados as List<Quantitary.Models.ReporteGuardado> ?? new List<Quantitary.Models.ReporteGuardado>();
    var totalReportes = ViewBag.TotalReportes as int? ?? reportesGuardados.Count;
    var resultadosReportes = ViewBag.ResultadosReportes as int? ?? reportesGuardados.Count;
    var busqueda = ViewBag.Busqueda as string;
    var tipoReporteFiltro = ViewBag.TipoReporteFiltro as string;
    var frecuenciaActualizacionFiltro = ViewBag.FrecuenciaActualizacionFiltro as string;
    var periodoTiempoFiltro = ViewBag.PeriodoTiempoFiltro as string;
    var fechaDesde = ViewBag.FechaDesde as DateTime?;
    var fechaHasta = ViewBag.FechaHasta as DateTime?;
    var exito = TempData["ReporteGuardadoExito"] as string;
    var cancelado = TempData["ReporteCancelado"] as string;

    var ultimoReporte = ViewBag.UltimoReporte as Quantitary.Models.ReporteGuardado;
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Reportes</h2>
            <p class="text-muted mb-0">Creá y visualizá reportes del negocio.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(exito))
    {
        <div class="alert alert-success">@exito</div>
    }

    @if (!string.IsNullOrWhiteSpace(cancelado))
    {
        <div class="alert alert-warning">@cancelado</div>
    }

    <div class="row g-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h5 class="card-title mb-3">Crear reporte</h5>

                    <form asp-controller="Home" asp-action="GuardarReporte" method="post" class="row g-3">
                        @Html.AntiForgeryToken()

                        <div class="col-12">
                            <label asp-for="Nombre" class="form-label">Nombre del reporte</label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Reporte de ventas semanal" />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="TipoReporte" class="form-label">Tipo de reporte</label>
                            <select asp-for="TipoReporte" class="form-select">
                                <option value="Ventas">Ventas</option>
                                <option value="Stock">Stock</option>
                                <option value="Productos">Productos</option>
                                <option value="Finanzas">Finanzas</option>
                            </select>
                            <span asp-validation-for="TipoReporte" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="PeriodoTiempo" class="form-label">Período de tiempo</label>
                            <select asp-for="PeriodoTiempo" class="form-select">
                                <option value="Diario">Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual" selected>Mensual</option>
                                <option value="Trimestral">Trimestral</option>
                                <option value="Anual">Anual</option>
                            </select>
                            <span asp-validation-for="PeriodoTiempo" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FormatoReporte" class="form-label">Formato del reporte</label>
                            <select asp-for="FormatoReporte" class="form-select">
                                <option value="PDF">PDF</option>
                                <option value="Excel">Excel</option>
                                <option value="CSV">CSV</option>
                                <option value="HTML">HTML</option>
                            </select>
                            <span asp-validation-for="FormatoReporte" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="FrecuenciaActualizacion" class="form-label">Cada cuánto se actualiza</label>
                            <select asp-for="FrecuenciaActualizacion" class="form-select">
                                <option value="Manual">Manual</option>
                                <option value="Diario">Diario</option>
                                <option value="Semanal">Semanal</option>
                                <option value="Mensual">Mensual</option>
                            </select>
                            <span asp-validation-for="FrecuenciaActualizacion" class="text-danger small"></span>
                        </div>

                        <div class="col-12" id="selectorProductosReporte">
                            <label class="form-label">Productos a analizar</label>
                            <select asp-for="ProductosIds" class="form-select" multiple size="6">
                                @foreach (var producto in ViewBag.ProductosDisponibles as List<Quantitary.Models.Producto> ?? new List<Quantitary.Models.Producto>())
                                {
                                    <option value="@producto.Id">@producto.Nombre (@producto.Sku)</option>
                                }
                            </select>
                            <div class="form-text">Solo se aplica al reporte de Productos. Sin selección se incluyen todos.</div>
                        </div>

                        <div class="col-12 d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-primary">Guardar</button>
                            <button type="submit" class="btn btn-outline-secondary" formaction="@Url.Action("CancelarReporte", "Home")" formmethod="post">Cancelar</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="card-title mb-0">Vista previa</h5>
                        @if (ultimoReporte != null)
                        {
                            <div class="d-flex gap-2">
                                <a asp-controller="Home" asp-action="VistaPreviaReporte" asp-route-id="@ultimoReporte.Id" target="_blank" class="btn btn-outline-primary btn-sm">Ver</a>
                                <a asp-controller="Home" asp-action="DescargarReporte" asp-route-id="@ultimoReporte.Id" class="btn btn-success btn-sm">Descargar</a>
                            </div>
                        }
                    </div>

                    @if (ultimoReporte != null)
                    {
                        <div class="border rounded p-3 bg-light">
                            @Html.Raw(ultimoReporte.VistaPreviaHtml)
                        </div>
                    }
                    else
                    {
                        <div class="text-muted">Aún no hay un reporte creado para visualizar.</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                    <h5 class="card-title mb-0">Reportes guardados</h5>
                    <span class="text-muted small">@resultadosReportes de @totalReportes reportes</span>
                </div>

                <form asp-controller="Home" asp-action="Reportes" method="get" class="report-filter-form border rounded p-3 mb-3 bg-light">
                    <div class="report-filter-grid">
                        <div class="report-filter-field">
                            <label for="busquedaReportes" class="form-label">Buscar por nombre</label>
                            <input id="busquedaReportes" name="busqueda" type="search" class="form-control" value="@busqueda" placeholder="Ej: ventas semanal" />
                        </div>

                        <div class="report-filter-field">
                            <label for="tipoReporteFiltro" class="form-label">Tipo</label>
                            <select id="tipoReporteFiltro" name="tipoReporte" class="form-select">
                                <option value="">Todos</option>
                                <option value="Ventas" selected="@(tipoReporteFiltro == "Ventas")">Ventas</option>
                                <option value="Stock" selected="@(tipoReporteFiltro == "Stock")">Stock</option>
                                <option value="Productos" selected="@(tipoReporteFiltro == "Productos")">Productos</option>
                                <option value="Finanzas" selected="@(tipoReporteFiltro == "Finanzas")">Finanzas</option>
                            </select>
                        </div>

                        <div class="report-filter-field">
                            <label for="fechaDesde" class="form-label">Creado desde</label>
                            <input id="fechaDesde" name="fechaDesde" type="date" class="form-control" value="@(fechaDesde?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="report-filter-field">
                            <label for="fechaHasta" class="form-label">Creado hasta</label>
                            <input id="fechaHasta" name="fechaHasta" type="date" class="form-control" value="@(fechaHasta?.ToString("yyyy-MM-dd"))" />
                        </div>

                        <div class="report-filter-field">
                            <label for="frecuenciaFiltro" class="form-label">Actualización</label>
                            <select id="frecuenciaFiltro" name="frecuenciaActualizacion" class="form-select">
                                <option value="">Todas</option>
                                <option value="Manual" selected="@(frecuenciaActualizacionFiltro == "Manual")">Manual</option>
                                <option value="Diario" selected="@(frecuenciaActualizacionFiltro == "Diario")">Diario</option>
                                <option value="Semanal" selected="@(frecuenciaActualizacionFiltro == "Semanal")">Semanal</option>
                                <option value="Mensual" selected="@(frecuenciaActualizacionFiltro == "Mensual")">Mensual</option>
                            </select>
                        </div>

                        <div class="report-filter-field">
                            <label for="periodoFiltro" class="form-label">Período incluido</label>
                            <select id="periodoFiltro" name="periodoTiempo" class="form-select">
                                <option value="">Todos</option>
                                <option value="Diario" selected="@(periodoTiempoFiltro == "Diario")">Diario</option>
                                <option value="Semanal" selected="@(periodoTiempoFiltro == "Semanal")">Semanal</option>
                                <option value="Mensual" selected="@(periodoTiempoFiltro == "Mensual")">Mensual</option>
                                <option value="Trimestral" selected="@(periodoTiempoFiltro == "Trimestral")">Trimestral</option>
                                <option value="Anual" selected="@(periodoTiempoFiltro == "Anual")">Anual</option>
                            </select>
                        </div>

                        <div class="report-filter-actions">
                            <button type="submit" class="btn btn-primary">Filtrar</button>
                            <a asp-controller="Home" asp-action="Reportes" class="btn btn-outline-secondary">Limpiar</a>
                        </div>
                    </div>
                </form>

                @if (reportesGuardados.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-striped align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Nombre</th>
                                    <th>Tipo</th>
                                    <th>Período incluido</th>
                                    <th>Formato</th>
                                    <th>Actualización</th>
                                    <th>Fecha de creación</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var reporte in reportesGuardados)
                                {
                                    <tr>
                                        <td>@reporte.Nombre</td>
                                        <td>@reporte.TipoReporte</td>
                                        <td>@reporte.PeriodoTiempo</td>
                                        <td>@reporte.FormatoReporte</td>
                                        <td>@reporte.FrecuenciaActualizacion</td>
                                        <td>@reporte.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else if (totalReportes > 0)
                {
                    <div class="text-muted">No se encontraron reportes con los filtros seleccionados.</div>
                }
                else
                {
                    <div class="text-muted">Todavía no hay reportes guardados.</div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        const tipoReporte = document.querySelector('[name="TipoReporte"]');
        const selectorProductos = document.getElementById('selectorProductosReporte');

        function actualizarSelectorProductos() {
            selectorProductos.style.display = tipoReporte?.value === 'Productos' ? '' : 'none';
        }

        tipoReporte?.addEventListener('change', actualizarSelectorProductos);
        actualizarSelectorProductos();
    </script>
}
