@{
    ViewData["Title"] = "Ventas y ganancias";
    var fechaInicio = ViewBag.FechaInicio as DateTime? ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    var fechaFin = ViewBag.FechaFin as DateTime? ?? new DateTime(DateTime.Today.Year, DateTime.Today.Month, DateTime.DaysInMonth(DateTime.Today.Year, DateTime.Today.Month), 23, 59, 59, 999);
    var ventasTotales = ViewBag.VentasTotales as decimal? ?? 0m;
    var gastosTotales = ViewBag.GastosTotales as decimal? ?? 0m;
    var ventaPromedio = ViewBag.VentaPromedio as decimal? ?? 0m;
    var ganancias = ViewBag.Ganancias as decimal? ?? 0m;
    var margenNeto = ViewBag.MargenNeto as decimal? ?? 0m;
    var ventaPorSemana = ViewBag.VentaPorSemana as List<Quantitary.Models.ChartPoint> ?? new List<Quantitary.Models.ChartPoint>();
    var gananciaPorCategoria = ViewBag.GananciaPorCategoria as List<Quantitary.Models.ChartPoint> ?? new List<Quantitary.Models.ChartPoint>();
    var maxVentaSemana = ventaPorSemana.Any() && ventaPorSemana.Max(v => v.Valor) > 0 ? ventaPorSemana.Max(v => v.Valor) : 1m;
    var maxGananciaCategoria = gananciaPorCategoria.Any() && gananciaPorCategoria.Max(v => v.Valor) > 0 ? gananciaPorCategoria.Max(v => v.Valor) : 1m;
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1">Ventas y ganancias</h2>
            <p class="text-muted mb-0">Rango actual: @fechaInicio.ToString("dd/MM/yyyy") - @fechaFin.ToString("dd/MM/yyyy")</p>
        </div>
    </div>

    <form method="get" asp-action="AnalisisVentasGanancias" class="row g-3 align-items-end mb-4">
        <div class="col-md-4">
            <label class="form-label">Fecha inicio</label>
            <input type="date" name="fechaInicio" value="@fechaInicio.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <label class="form-label">Fecha fin</label>
            <input type="date" name="fechaFin" value="@fechaFin.ToString("yyyy-MM-dd")" class="form-control" />
        </div>
        <div class="col-md-4">
            <button type="submit" class="btn btn-primary w-100">Aplicar filtro</button>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="kpi-card">
                <span class="kpi-label">Ventas Totales</span>
                <strong class="kpi-value">$@ventasTotales.ToString("N2")</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card warning-card">
                <span class="kpi-label">Gastos Totales</span>
                <strong class="kpi-value">$@gastosTotales.ToString("N2")</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card success-card">
                <span class="kpi-label">Venta Promedio</span>
                <strong class="kpi-value">$@ventaPromedio.ToString("N2")</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card info-card">
                <span class="kpi-label">Ganancias</span>
                <strong class="kpi-value">$@ganancias.ToString("N2")</strong>
            </div>
        </div>
        <div class="col-md-12">
            <div class="kpi-card">
                <span class="kpi-label">Margen Neto</span>
                <strong class="kpi-value">@margenNeto.ToString("N2")%</strong>
            </div>
        </div>
    </div>

    <div class="row g-4 mt-1">
        <div class="col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-header">
                    <h4>Venta por semana</h4>
                    <small>Acumulado por semanas dentro del período</small>
                </div>

                <div class="bars-panel">
                    @for (int i = 0; i < ventaPorSemana.Count; i++)
                    {
                        var semana = ventaPorSemana[i];
                        var altura = maxVentaSemana > 0 ? Math.Max(8, (double)(semana.Valor / maxVentaSemana) * 100) : 8;
                        <div class="bar-col">
                            <div class="bar-value">@semana.Valor.ToString("N0")</div>
                            <div class="bar-track">
                                <div class="bar-fill" style="height:@altura%; background:#2f80ed;"></div>
                            </div>
                            <div class="bar-label">@semana.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="chart-card h-100">
                <div class="chart-header">
                    <h4>Ganancia neta por categoría</h4>
                    <small>Netos por categoría durante el rango</small>
                </div>

                <div class="bars-panel category-bars">
                    @for (int i = 0; i < gananciaPorCategoria.Count; i++)
                    {
                        var categoria = gananciaPorCategoria[i];
                        var altura = maxGananciaCategoria > 0 ? Math.Max(8, (double)(categoria.Valor / maxGananciaCategoria) * 100) : 8;
                        <div class="bar-col">
                            <div class="bar-value">@categoria.Valor.ToString("N0")</div>
                            <div class="bar-track">
                                <div class="bar-fill alternate" style="height:@altura%; background:#27ae60;"></div>
                            </div>
                            <div class="bar-label">@categoria.Label</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
