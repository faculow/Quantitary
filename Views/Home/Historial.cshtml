@{
    ViewData["Title"] = "Historial";
    var dashboard = ViewBag.Dashboard as Quantitary.Models.DashboardSummary;
    var rango = ViewBag.RangoActual ?? "mes";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var nombreProducto = ViewBag.NombreProducto as string ?? string.Empty;
    var sku = ViewBag.Sku as string ?? string.Empty;
    var categoria = ViewBag.Categoria as string ?? string.Empty;
    var busqueda = ViewBag.Busqueda as string ?? string.Empty;
    var mensajeAdvertencia = ViewBag.MensajeAdvertencia as string;
    var podioVentas = (dashboard?.PodioProductosMasVendidos ?? new List<Quantitary.Models.ProductoRanking>()).ToList();
    var podioGanancia = (dashboard?.PodioProductosMasGanancia ?? new List<Quantitary.Models.ProductoRanking>()).ToList();
    var ventas = (dashboard?.UltimosProductosVendidos ?? new List<Quantitary.Models.VentaRegistro>()).ToList();
}

@if (!string.IsNullOrWhiteSpace(mensajeAdvertencia))
{
    <div class="alert alert-warning mt-3">@mensajeAdvertencia</div>
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <h2 class="mb-0">Historial</h2>
        <div class="btn-group" role="group">
            <a class="btn btn-sm @(rango == "dia" ? "btn-primary" : "btn-outline-primary")" asp-route-rango="dia" asp-route-nombreProducto="@nombreProducto" asp-route-sku="@sku" asp-route-categoria="@categoria">Día</a>
            <a class="btn btn-sm @(rango == "semana" ? "btn-primary" : "btn-outline-primary")" asp-route-rango="semana" asp-route-nombreProducto="@nombreProducto" asp-route-sku="@sku" asp-route-categoria="@categoria">Semana</a>
            <a class="btn btn-sm @(rango == "mes" ? "btn-primary" : "btn-outline-primary")" asp-route-rango="mes" asp-route-nombreProducto="@nombreProducto" asp-route-sku="@sku" asp-route-categoria="@categoria">Mes</a>
            <a class="btn btn-sm @(rango == "año" ? "btn-primary" : "btn-outline-primary")" asp-route-rango="año" asp-route-nombreProducto="@nombreProducto" asp-route-sku="@sku" asp-route-categoria="@categoria">Año</a>
        </div>
    </div>

    <form method="get" asp-action="Historial" class="row g-3 align-items-end mb-4">
        <input type="hidden" name="rango" value="@rango" />

        <div class="col-md-4">
            <label class="form-label">Buscar por nombre</label>
            <input type="text" name="nombreProducto" value="@nombreProducto" class="form-control" placeholder="Ej: Yogur" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Buscar por SKU</label>
            <input type="text" name="sku" value="@sku" class="form-control" placeholder="Ej: LA-001" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Categoría</label>
            <select name="categoria" class="form-select">
                <option value="">Todas</option>
                @foreach (var item in categorias)
                {
                    <option value="@item" selected="@(string.Equals(item, categoria, StringComparison.OrdinalIgnoreCase) ? "selected" : null)">@item</option>
                }
            </select>
        </div>

        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">Buscar</button>
            <a asp-action="Historial" asp-route-rango="@rango" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="kpi-card"><span>Ventas totales</span><strong>@(dashboard?.VentasTotales ?? 0)</strong></div></div>
        <div class="col-md-3"><div class="kpi-card"><span>Mes con mayores ventas</span><strong>@(dashboard?.MesMayorVentas ?? "-")</strong></div></div>
        <div class="col-md-3"><div class="kpi-card"><span>Venta promedio</span><strong>$@((dashboard?.VentaPromedioPorMes ?? 0).ToString("N2"))</strong></div></div>
        <div class="col-md-3"><div class="kpi-card"><span>Ganancia promedio por producto</span><strong>$@((dashboard?.GananciaPromedioPorProducto ?? 0).ToString("N2"))</strong></div></div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="panel subpanel podium-card">
                <h3>Podio de productos más vendidos</h3>
                @if (podioVentas.Any())
                {
                    <div class="podium-wrap">
                        @for (var i = 0; i < podioVentas.Count; i++)
                        {
                            var item = podioVentas[i];
                            var podiumClass = i == 0 ? "first" : i == 1 ? "second" : "third";
                            var medal = i == 0 ? "🥇" : i == 1 ? "🥈" : "🥉";
                            var height = Math.Max(40, 100 - (i * 18));

                            <div class="podium-item @podiumClass">
                                <div class="podium-rank">@medal</div>
                                <div class="podium-content">
                                    <div class="podium-name">@item.Nombre</div>
                                    <div class="podium-meta">@($"{item.Cantidad} unidades")</div>
                                </div>
                                <div class="podium-bar" style="height:@height%"></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay datos.</div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="panel subpanel podium-card">
                <h3>Podio de productos con más ganancia</h3>
                @if (podioGanancia.Any())
                {
                    <div class="podium-wrap">
                        @for (var i = 0; i < podioGanancia.Count; i++)
                        {
                            var item = podioGanancia[i];
                            var podiumClass = i == 0 ? "first" : i == 1 ? "second" : "third";
                            var medal = i == 0 ? "🥇" : i == 1 ? "🥈" : "🥉";
                            var height = Math.Max(40, 100 - (i * 18));

                            <div class="podium-item @podiumClass">
                                <div class="podium-rank">@medal</div>
                                <div class="podium-content">
                                    <div class="podium-name">@item.Nombre</div>
                                    <div class="podium-meta">$@item.Total.ToString("N2")</div>
                                </div>
                                <div class="podium-bar" style="height:@height%"></div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-muted">No hay datos.</div>
                }
            </div>
        </div>
    </div>

    <div class="mt-4 panel subpanel">
        <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
            <h3 class="mb-0">Últimos productos vendidos</h3>
            <form method="get" asp-action="Historial" class="d-flex align-items-center gap-2 ms-auto" style="max-width: 460px; width: 100%;">
                <input type="hidden" name="rango" value="@rango" />
                <input type="text" name="busqueda" class="form-control" value="@busqueda" placeholder="Buscar por nombre, SKU o categoría" />
                <button type="submit" class="btn btn-primary">Buscar</button>
            </form>
        </div>

        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Producto</th>
                    <th>SKU</th>
                    <th>Categoría</th>
                    <th>Fecha y horario</th>
                    <th>Método de pago</th>
                    <th>Cantidad</th>
                    <th>Precio</th>
                </tr>
            </thead>
            <tbody>
                @if (ventas.Any())
                {
                    foreach (var venta in ventas)
                    {
                        <tr>
                            <td>@venta.NombreProducto</td>
                            <td>@venta.Sku</td>
                            <td>@venta.Categoria</td>
                            <td>@venta.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@venta.MetodoPago</td>
                            <td>@venta.Cantidad</td>
                            <td>$@venta.Precio.ToString("N2")</td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="7" class="text-center text-muted">Sin ventas en este rango.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
