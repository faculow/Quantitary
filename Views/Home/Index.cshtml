@{
    Layout = null;
    ViewData["Title"] = "Quantitary - Landing";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/style.css" asp-append-version="true" />
</head>
<body>
    <div class="landing-shell">
        <header class="landing-topbar">
            <div class="brand-mark">
                <span class="brand-dot"></span>
                <span>Quantitary</span>
            </div>

            <div class="topbar-actions">
                <a asp-controller="Cuenta" asp-action="Login" class="topbar-link">Iniciar sesión</a>
                <a asp-controller="Cuenta" asp-action="Registro" class="btn-quantary btn-secondary-quantary">Crear cuenta</a>
            </div>
        </header>

        <main>
            <section class="landing-hero">
                <div class="landing-copy">
                    <p class="eyebrow">Quantitary · Landing pública</p>
                    <h1>Tu negocio, <span>más claro.</span></h1>
                    <p class="landing-text">
                        Centralizá ventas, stock y decisiones con una herramienta pensada para equipos que quieren crecer con orden y rapidez.
                    </p>

                    <div class="landing-actions">
                        <a asp-controller="Cuenta" asp-action="Login" class="btn-quantary btn-primary-quantary">Iniciar sesión</a>
                        <a asp-controller="Cuenta" asp-action="Registro" class="btn-quantary btn-secondary-quantary">Crear cuenta</a>
                    </div>

                    <ul class="landing-points">
                        <li>Control de stock en tiempo real</li>
                        <li>Indicadores de ventas y rentabilidad</li>
                        <li>Gestión simple y centralizada</li>
                    </ul>
                </div>

                <div class="landing-visual">
                    <div class="dashboard-preview" aria-label="Vista previa del panel">
                        <div class="preview-topbar">
                            <span class="dot dot-red"></span>
                            <span class="dot dot-yellow"></span>
                            <span class="dot dot-green"></span>
                        </div>

                        <div class="preview-content">
                            <div class="preview-card preview-card-main">
                                <span class="preview-label">Ventas</span>
                                <strong>$156.800</strong>
                                <small>+18.4% vs. mes anterior</small>
                            </div>

                            <div class="preview-grid">
                                <div class="preview-card small-card">
                                    <span>Stock</span>
                                    <strong>1.284</strong>
                                </div>
                                <div class="preview-card small-card accent">
                                    <span>Ganancia</span>
                                    <strong>$46.300</strong>
                                </div>
                            </div>

                            <div class="mini-chart" aria-hidden="true">
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="landing-features">
                <article class="feature-card">
                    <span class="feature-icon">📊</span>
                    <h3>Ventas claras</h3>
                    <p>Visualizá el movimiento de tu negocio con métricas listas para analizar.</p>
                </article>

                <article class="feature-card">
                    <span class="feature-icon">📦</span>
                    <h3>Inventario ordenado</h3>
                    <p>Seguimiento del stock, alertas y decisiones más rápidas para cada producto.</p>
                </article>

                <article class="feature-card">
                    <span class="feature-icon">⚡</span>
                    <h3>Operación sencilla</h3>
                    <p>Todo en un mismo lugar para reducir tiempos de gestión y mejorar resultados.</p>
                </article>
            </section>

            <section class="landing-banner">
                <div>
                    <p class="landing-banner-kicker">¿Querés mejorar tu control?</p>
                    <h2>Un panel pensado para decisiones más inteligentes.</h2>
                </div>
                <a asp-controller="Cuenta" asp-action="Registro" class="btn-quantary btn-light-quantary">Comenzar ahora</a>
            </section>
        </main>
    </div>
</body>
</html>
