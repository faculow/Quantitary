@model Quantitary.Models.IndicadoresYOportunidadesViewModel
@{
    ViewData["Title"] = "Indicadores y oportunidades";
    var resumenProgramado = TempData["ReporteProgramado"] as string;
    var categoriaDisponible = !string.IsNullOrWhiteSpace(Model.CategoriaMasVentas) && !string.Equals(Model.CategoriaMasVentas, "Sin datos", StringComparison.OrdinalIgnoreCase);
    var proximoPaso = !string.IsNullOrWhiteSpace(Model.MensajePersonalizadoProximoPaso)
        ? Model.MensajePersonalizadoProximoPaso
        : Model.ExplicacionesIndicadores.FirstOrDefault();
    var mostrarProximoPaso = Model.TotalProductos > 0
        && !string.IsNullOrWhiteSpace(proximoPaso)
        && !string.Equals(proximoPaso, "Sin datos", StringComparison.OrdinalIgnoreCase);
}

<div class="panel indicadores-shell">
    @if (!string.IsNullOrWhiteSpace(resumenProgramado))
    {
        <div class="alert alert-info alert-compact mt-2 mb-3">@resumenProgramado</div>
    }

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <p class="eyebrow">Indicadores</p>
            <h2 class="mb-1">Indicadores y oportunidades</h2>
            <p class="text-muted mb-0">Resumen operativo para decidir compras, reposición y stock mínimo.</p>
        </div>
        <div class="d-flex gap-2">
            <form asp-action="ExportarResumenIndicadores" method="get">
                <button type="submit" class="btn btn-primary">Exportar</button>
            </form>
            <form asp-action="ProgramarReporteIndicadores" method="post">
                <button type="submit" class="btn btn-outline-secondary">Programar</button>
            </form>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="kpi-card">
                <span class="kpi-label">Margen neto</span>
                <strong class="kpi-value">@Model.MargenNetoGeneral.ToString("0.##")%</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card success-card">
                <span class="kpi-label">Mayor rotación</span>
                <strong class="kpi-value indicadores-kpi-text">@Model.ProductoMayorRotacion</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card warning-card">
                <span class="kpi-label">Relación interés/compra</span>
                <strong class="kpi-value indicadores-kpi-text">@Model.RelacionInteresCompra</strong>
            </div>
        </div>
        <div class="col-md-3">
            <div class="kpi-card info-card">
                <span class="kpi-label">Categoría con más ventas</span>
                <strong class="kpi-value indicadores-kpi-text">@Model.CategoriaMasVentas</strong>
                <span class="kpi-foot">@(categoriaDisponible ? "Lidera las ventas" : "Aún sin datos de ventas")</span>
            </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Qué hacer ahora</h5>
        <div class="row g-3">
            <div class="col-lg-6">
                <div class="list-card">
                    <h4>Reponer</h4>
                    @if (Model.ProductosReponer.Any())
                    {
                        <ul>
                            @foreach (var producto in Model.ProductosReponer)
                            {
                                <li>@producto</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Sin urgencias</p>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="list-card">
                    <h4>Comprar menos</h4>
                    @if (Model.ProductosComprarMenos.Any())
                    {
                        <ul>
                            @foreach (var producto in Model.ProductosComprarMenos)
                            {
                                <li>@producto</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Todo bien</p>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="list-card">
                    <h4>Comprar más</h4>
                    @if (Model.ProductosComprarMas.Any())
                    {
                        <ul>
                            @foreach (var producto in Model.ProductosComprarMas)
                            {
                                <li>@producto</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>Sin acción</p>
                    }
                </div>
            </div>
            <div class="col-lg-6">
                <div class="list-card">
                    <h4>Mín. reposición</h4>
                    @if (Model.ProductosCambiarMinimo.Any())
                    {
                        <ul>
                            @foreach (var producto in Model.ProductosCambiarMinimo)
                            {
                                <li>@producto</li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p>En orden</p>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="card-title">Productos clave</h5>
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Rot.</th>
                        <th>Acción</th>
                        <th>Stock</th>
                        <th>Mín. rep.</th>
                        <th>Compra</th>
                        <th>Venta</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Productos)
                    {
                        <tr>
                            <td>@item.Nombre</td>
                            <td>@item.Rotacion.ToString("0.##")</td>
                            <td>
                                <span class="badge @(item.AccionSugerida == "Reponer" ? "bg-warning text-dark" : item.AccionSugerida == "Comprar menos" ? "bg-secondary" : "bg-success")">
                                    @item.AccionSugerida
                                </span>
                            </td>
                            <td>@item.StockActual</td>
                            <td>
                                <span class="reorder-pill @(item.MinimoReposicionTexto.Contains("Subir") ? "reorder-up" : item.MinimoReposicionTexto.Contains("Bajar") ? "reorder-down" : "reorder-stable")">
                                    @item.MinimoReposicionTexto
                                </span>
                            </td>
                            <td>@item.CompraPlazoTexto</td>
                            <td>@item.FechaVentaSugerida</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h5 class="card-title">Resumen</h5>
        <div class="status-summary compact-summary">
            <span class="status-label">Estado:</span>
            <strong>@Model.ResumenEstado</strong>
        </div>
        <div class="mini-help">
            <div><strong>Más vendido:</strong> @Model.ProductoMayorRotacion</div>
            <div><strong>Más ventas:</strong> @Model.CategoriaMasVentas</div>
            @if (mostrarProximoPaso)
            {
                <div><strong>Próximo paso:</strong> @proximoPaso</div>
            }
        </div>
        </div>
    </div>
</div>
