@model List<Quantitary.Models.ReporteGuardado>
@{
    ViewData["Title"] = "Historial de reportes";
    var resultados = ViewBag.ResultadosReportes as int? ?? Model.Count;
    var busqueda = ViewBag.Busqueda as string;
    var tipoReporte = ViewBag.TipoReporteFiltro as string;
    var frecuencia = ViewBag.FrecuenciaActualizacionFiltro as string;
    var periodo = ViewBag.PeriodoTiempoFiltro as string;
    var fechaDesde = ViewBag.FechaDesde as DateTime?;
    var fechaHasta = ViewBag.FechaHasta as DateTime?;
    var eliminado = TempData["ReporteEliminado"] as string;
    var eliminadoError = TempData["ReporteEliminadoError"] as string;
}

<div class="panel historial-page">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-3">
        <div>
            <h2 class="mb-1">Historial de reportes</h2>
            <p class="text-muted mb-0">Consultá, descargá o eliminá los reportes guardados.</p>
        </div>
        <div class="text-end">
            <a asp-controller="Home" asp-action="Reportes" class="btn btn-primary btn-sm">+ Nuevo reporte</a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(eliminado))
    {
        <div class="alert alert-success">@eliminado</div>
    }
    @if (!string.IsNullOrWhiteSpace(eliminadoError))
    {
        <div class="alert alert-danger">@eliminadoError</div>
    }

    <form asp-controller="Home" asp-action="HistorialReportes" method="get" class="historial-filtros mb-3">
        <div class="historial-buscador">
            <label for="busquedaHistorial" class="form-label mb-1">Buscar por nombre</label>
            <input id="busquedaHistorial" name="busqueda" type="search" class="form-control form-control-sm" value="@busqueda" placeholder="Buscar reportes..." />
        </div>

        <details class="historial-filtros-desplegable">
            <summary class="btn btn-outline-secondary btn-sm">Filtros</summary>
            <div class="historial-filtros-grid mt-2">
                <div>
                    <label for="tipoReporteHistorial" class="form-label mb-1">Tipo</label>
                    <select id="tipoReporteHistorial" name="tipoReporte" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @if (tipoReporte == "Ventas") { <option value="Ventas" selected>Ventas</option> } else { <option value="Ventas">Ventas</option> }
                        @if (tipoReporte == "Stock") { <option value="Stock" selected>Stock</option> } else { <option value="Stock">Stock</option> }
                        @if (tipoReporte == "Productos") { <option value="Productos" selected>Productos</option> } else { <option value="Productos">Productos</option> }
                        @if (tipoReporte == "Finanzas") { <option value="Finanzas" selected>Finanzas</option> } else { <option value="Finanzas">Finanzas</option> }
                    </select>
                </div>

                <div>
                    <label for="frecuenciaHistorial" class="form-label mb-1">Actualización</label>
                    <select id="frecuenciaHistorial" name="frecuenciaActualizacion" class="form-select form-select-sm">
                        <option value="">Todas</option>
                        @if (frecuencia == "Manual") { <option value="Manual" selected>Manual</option> } else { <option value="Manual">Manual</option> }
                        @if (frecuencia == "Diario") { <option value="Diario" selected>Diario</option> } else { <option value="Diario">Diario</option> }
                        @if (frecuencia == "Semanal") { <option value="Semanal" selected>Semanal</option> } else { <option value="Semanal">Semanal</option> }
                        @if (frecuencia == "Mensual") { <option value="Mensual" selected>Mensual</option> } else { <option value="Mensual">Mensual</option> }
                    </select>
                </div>

                <div>
                    <label for="periodoHistorial" class="form-label mb-1">Período de análisis</label>
                    <select id="periodoHistorial" name="periodoTiempo" class="form-select form-select-sm">
                        <option value="">Todos</option>
                        @if (periodo == "Diario") { <option value="Diario" selected>Diario</option> } else { <option value="Diario">Diario</option> }
                        @if (periodo == "Semanal") { <option value="Semanal" selected>Semanal</option> } else { <option value="Semanal">Semanal</option> }
                        @if (periodo == "Mensual") { <option value="Mensual" selected>Mensual</option> } else { <option value="Mensual">Mensual</option> }
                        @if (periodo == "Trimestral") { <option value="Trimestral" selected>Trimestral</option> } else { <option value="Trimestral">Trimestral</option> }
                        @if (periodo == "Anual") { <option value="Anual" selected>Anual</option> } else { <option value="Anual">Anual</option> }
                    </select>
                </div>

                <div>
                    <label for="fechaDesdeHistorial" class="form-label mb-1">Creado desde</label>
                    <input id="fechaDesdeHistorial" name="fechaDesde" type="date" class="form-control form-control-sm" value="@(fechaDesde?.ToString("yyyy-MM-dd"))" />
                </div>

                <div>
                    <label for="fechaHastaHistorial" class="form-label mb-1">Creado hasta</label>
                    <input id="fechaHastaHistorial" name="fechaHasta" type="date" class="form-control form-control-sm" value="@(fechaHasta?.ToString("yyyy-MM-dd"))" />
                </div>

                <div class="historial-filtros-actions">
                    <button type="submit" class="btn btn-primary btn-sm">Aplicar</button>
                    <a asp-controller="Home" asp-action="HistorialReportes" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                </div>
            </div>
        </details>
    </form>

    <div class="d-flex justify-content-between align-items-center mb-2">
        <span class="text-muted small">@resultados reportes encontrados</span>
    </div>

    @if (Model.Any())
    {
        <div class="table-responsive historial-tabla-card">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Nombre</th>
                        <th>Tipo</th>
                        <th>Período de análisis</th>
                        <th>Formato</th>
                        <th>Actualización</th>
                        <th>Fecha de creación</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var reporte in Model)
                    {
                        <tr>
                            <td>@reporte.Nombre</td>
                            <td>@reporte.TipoReporte</td>
                            <td>@reporte.PeriodoTiempo</td>
                            <td>@reporte.FormatoReporte</td>
                            <td>@reporte.FrecuenciaActualizacion</td>
                            <td>@reporte.FechaCreacion.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                <div class="d-flex justify-content-end gap-1 flex-wrap">
                                    <a asp-controller="Home" asp-action="VistaPreviaReporte" asp-route-id="@reporte.Id" target="_blank" class="btn btn-outline-primary btn-sm">Ver</a>
                                    <a asp-controller="Home" asp-action="DescargarReporte" asp-route-id="@reporte.Id" class="btn btn-success btn-sm">Descargar</a>
                                    <form asp-controller="Home" asp-action="EliminarReporte" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@reporte.Id" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">Borrar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="border rounded p-4 text-center text-muted">No se encontraron reportes con los filtros seleccionados.</div>
    }
</div>
