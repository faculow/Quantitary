@model Quantitary.Models.Usuario
@{
    ViewData["Title"] = "Crear cuenta";
}

<div class="auth-page auth-page-register">
    <div class="auth-card">
        <img src="~/images/quantitary-logo-app.png" alt="Quantitary" class="auth-card-logo" />
        <h2>Crear cuenta</h2>
        <p class="auth-card-subtitle">Completá tus datos para comenzar</p>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Registro" asp-controller="Cuenta">
            <div class="auth-form-grid">
                <div class="mb-3">
                    <label class="form-label" asp-for="NombreUsuario">Nombre de usuario</label>
                    <input asp-for="NombreUsuario" class="form-control" autocomplete="username" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Mail">Correo electrónico</label>
                    <input asp-for="Mail" type="email" class="form-control" autocomplete="email" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="Contrasena">Contraseña</label>
                    <input asp-for="Contrasena" type="password" class="form-control" autocomplete="new-password" required />
                </div>
                <div class="mb-3">
                    <label class="form-label" asp-for="NombreEmpresa">Nombre de la empresa</label>
                    <input asp-for="NombreEmpresa" class="form-control" autocomplete="organization" required />
                </div>
                <div class="mb-3 auth-field-full">
                    <label class="form-label" asp-for="NumeroTelefono">Teléfono</label>
                    <input asp-for="NumeroTelefono" class="form-control" autocomplete="tel" />
                </div>
            </div>
            <button type="submit" class="btn btn-success w-100 auth-login-button">Registrarme</button>
        </form>

        <p class="auth-switch">
            ¿Ya tenés una cuenta?
            <a asp-action="Login" asp-controller="Cuenta">Iniciar sesión</a>
        </p>
    </div>
</div>
