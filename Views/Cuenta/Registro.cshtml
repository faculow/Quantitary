@model Quantitary.Models.Usuario
@{
    ViewData["Title"] = "Registro";
}

<div class="auth-card">
    <h2>Crear cuenta</h2>
    @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
    {
        <div class="alert alert-danger">@ViewBag.Error</div>
    }

    <form method="post" asp-action="Registro" asp-controller="Cuenta">
        <div class="mb-3">
            <label class="form-label">Nombre de usuario</label>
            <input asp-for="NombreUsuario" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo</label>
            <input asp-for="Mail" type="email" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Contraseña</label>
            <input asp-for="Contrasena" type="password" class="form-control" required />
        </div>
        <div class="mb-3">
            <label class="form-label">Teléfono</label>
            <input asp-for="NumeroTelefono" class="form-control" />
        </div>
        <button type="submit" class="btn btn-success w-100">Registrarme</button>
    </form>

    <div class="mt-3 text-center">
        <a asp-action="Login" asp-controller="Cuenta">Ya tengo cuenta</a>
    </div>
</div>
