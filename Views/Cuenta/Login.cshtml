@{
    ViewData["Title"] = "Iniciar sesión";
}

<div class="auth-page">
    <div class="auth-card">
        <img src="~/images/quantitary-logo-app.png" alt="Quantitary" class="auth-card-logo" />
        <h2>Iniciar sesión</h2>
        <p class="auth-card-subtitle">Ingresá tus datos para continuar</p>

        @if (!string.IsNullOrWhiteSpace(ViewBag.Error as string))
        {
            <div class="alert alert-danger" role="alert">@ViewBag.Error</div>
        }

        <form method="post" asp-action="Login" asp-controller="Cuenta">
            <div class="mb-3">
                <label class="form-label" for="mail">Correo electrónico</label>
                <input id="mail" type="email" name="mail" class="form-control" autocomplete="email" placeholder="usuario@ejemplo.com" required />
            </div>
            <div class="mb-3">
                <label class="form-label" for="contrasena">Contraseña</label>
                <input id="contrasena" type="password" name="contrasena" class="form-control" autocomplete="current-password" placeholder="••••••••" required />
            </div>
            <button type="submit" class="btn btn-primary w-100 auth-login-button">Iniciar sesión</button>
        </form>

        <p class="auth-switch">
            ¿Olvidaste tu contraseña?
            <a asp-action="Registro" asp-controller="Cuenta">Crear cuenta</a>
        </p>
    </div>
</div>
