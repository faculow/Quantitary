@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();

    var esInicio = controladorActual == "Home" && accionActual == "Index";
    var esHistorial = controladorActual == "Home" && accionActual == "Historial";
    var esStock = controladorActual == "Stock";
    var esPdv = controladorActual == "Pdv" && accionActual == "Index";
    var esAnalisis = controladorActual == "Home" && (accionActual == "AnalisisVentasGanancias" || accionActual == "AnalisisProducto");
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quantitary</title>
    <link rel="icon" type="image/png" href="~/imagenes/logo.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <img src="~/imagenes/logo.png" alt="Quantitary" class="brand-logo" />
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-link-side @(esInicio ? "active" : "")" aria-current="@(esInicio ? "page" : null)">
                    <img src="~/imagenes/inicio.png" alt="Inicio" class="nav-icon" />
                    <span>Inicio</span>
                </a>
                <a asp-controller="Pdv" asp-action="Index" class="nav-link-side @(esPdv ? "active" : "")" aria-current="@(esPdv ? "page" : null)">
                    <img src="~/imagenes/stock.png" alt="Punto de venta" class="nav-icon" />
                    <span>PDV</span>
                </a>
                <a asp-controller="Stock" asp-action="Index" class="nav-link-side @(esStock ? "active" : "")" aria-current="@(esStock ? "page" : null)">
                    <img src="~/imagenes/stock.png" alt="Stock" class="nav-icon" />
                    <span>Stock</span>
                </a>
                <a asp-controller="Home" asp-action="Historial" class="nav-link-side @(esHistorial ? "active" : "")" aria-current="@(esHistorial ? "page" : null)">
                    <img src="~/imagenes/historial.png" alt="Historial" class="nav-icon" />
                    <span>Historial</span>
                </a>
                <a asp-controller="Home" asp-action="AnalisisVentasGanancias" class="nav-link-side @(esAnalisis && accionActual == "AnalisisVentasGanancias" ? "active" : "")" aria-current="@(esAnalisis && accionActual == "AnalisisVentasGanancias" ? "page" : null)">
                    <img src="~/imagenes/historial.png" alt="Análisis" class="nav-icon" />
                    <span>Análisis</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-logout">Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <a class="brand-mini" asp-controller="Home" asp-action="Index">
                        <img src="~/imagenes/logo.png" alt="Quantitary" class="brand-mini-logo" />
                    </a>
                </div>

                <div class="topbar-right">
                    <button type="button" class="btn btn-icon" aria-label="Notificaciones">
                        <img src="~/imagenes/notificacion.png" alt="Notificaciones" class="icon-img" />
                    </button>
                    <div class="user-pill">
                        <img src="~/imagenes/avatar.png" alt="Usuario" class="user-avatar-img" />
                        <span>@(Context.Session.GetString("NombreUsuario") ?? "Usuario")</span>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
