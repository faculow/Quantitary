@{
    var controladorActual = ViewContext.RouteData.Values["controller"]?.ToString();
    var accionActual = ViewContext.RouteData.Values["action"]?.ToString();

    var esInicio = controladorActual == "Home" && accionActual == "Index";
    var esHistorial = controladorActual == "Home" && accionActual == "Historial";
    var esStock = controladorActual == "Stock";
    var esPdv = controladorActual == "Pdv" && accionActual == "Index";
    var esAnalisis = controladorActual == "Home" && (accionActual == "AnalisisVentasGanancias" || accionActual == "AnalisisProducto");
    var esIndicadores = controladorActual == "Home" && accionActual == "IndicadoresYOportunidades";
    var esAjustes = controladorActual == "Ajustes";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quantitary</title>
    <link rel="icon" type="image/png" href="~/images/quantitary-logo-app.png" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/quantitary-ia.css" asp-append-version="true" />
    <script>
        (() => {
            try {
                const selected = localStorage.getItem('quantitary.theme') || 'system';
                const theme = selected === 'system'
                    ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
                    : selected;
                document.documentElement.dataset.quantitaryTheme = theme;
                document.documentElement.dataset.quantitaryDensity =
                    localStorage.getItem('quantitary.density') || 'comfortable';
            } catch {
                document.documentElement.dataset.quantitaryTheme = 'light';
                document.documentElement.dataset.quantitaryDensity = 'comfortable';
            }
        })();
    </script>
</head>
<body class="app-body">
    <div class="app-shell">
        <aside class="sidebar">
            <div class="sidebar-brand">
                <img src="~/images/quantitary-logo-app.png" alt="Quantitary" class="brand-logo" />
            </div>

            <nav class="sidebar-nav">
                <a asp-controller="Home" asp-action="Index" class="nav-link-side @(esInicio ? "active" : "")" aria-current="@(esInicio ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M3.5 10.5 12 3.8l8.5 6.7"></path>
                        <path d="M5.5 9.5V20h13V9.5"></path>
                        <path d="M9.5 20v-6h5v6"></path>
                    </svg>
                    <span>Inicio</span>
                </a>
                <a asp-controller="Pdv" asp-action="Index" class="nav-link-side @(esPdv ? "active" : "")" aria-current="@(esPdv ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M7 4h10l1 6H6z"></path>
                        <path d="M5 10h14l1.5 4v6h-17v-6z"></path>
                        <path d="M7 14h6M7 17h10"></path>
                        <circle cx="17" cy="14" r="1"></circle>
                    </svg>
                    <span>POS</span>
                </a>
                <a asp-controller="Stock" asp-action="Index" class="nav-link-side @(esStock ? "active" : "")" aria-current="@(esStock ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="m4 7 8-4 8 4-8 4z"></path>
                        <path d="M4 7v10l8 4 8-4V7"></path>
                        <path d="M12 11v10"></path>
                    </svg>
                    <span>Stock</span>
                </a>
                <a asp-controller="Home" asp-action="Historial" class="nav-link-side @(esHistorial ? "active" : "")" aria-current="@(esHistorial ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4.4 8A8.5 8.5 0 1 1 3.5 14"></path>
                        <path d="M4 3.8V8h4.2"></path>
                        <path d="M12 7.5V12l3 2"></path>
                    </svg>
                    <span>Historial</span>
                </a>
                <a asp-controller="Home" asp-action="IndicadoresYOportunidades" class="nav-link-side @(esIndicadores ? "active" : "")" aria-current="@(esIndicadores ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 18a8 8 0 1 1 16 0"></path>
                        <path d="M7 18h10"></path>
                        <path d="m12 15 4-5"></path>
                        <circle cx="12" cy="15" r="1.2"></circle>
                    </svg>
                    <span>Indicadores</span>
                </a>
                <a asp-controller="Home" asp-action="AnalisisVentasGanancias" class="nav-link-side @(esAnalisis && accionActual == "AnalisisVentasGanancias" ? "active" : "")" aria-current="@(esAnalisis && accionActual == "AnalisisVentasGanancias" ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M4 19.5V14h3v5.5zM10.5 19.5V9h3v10.5zM17 19.5V5h3v14.5z"></path>
                        <path d="M3 19.5h18"></path>
                    </svg>
                    <span>Análisis</span>
                </a>
            </nav>

            <div class="sidebar-footer">
                <a asp-controller="Ajustes" asp-action="Index" class="nav-link-side settings-link @(esAjustes ? "active" : "")" aria-current="@(esAjustes ? "page" : null)">
                    <svg class="nav-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                        <circle cx="12" cy="12" r="3"></circle>
                        <path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1-2.8 2.8-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.6v.2h-4V21a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1L4.2 17l.1-.1a1.7 1.7 0 0 0 .3-1.9A1.7 1.7 0 0 0 3 14H2.8v-4H3a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9L4.2 7 7 4.2l.1.1A1.7 1.7 0 0 0 9 4.6a1.7 1.7 0 0 0 1-1.6v-.2h4V3a1.7 1.7 0 0 0 1 1.6 1.7 1.7 0 0 0 1.9-.3l.1-.1L19.8 7l-.1.1a1.7 1.7 0 0 0-.3 1.9 1.7 1.7 0 0 0 1.6 1h.2v4H21a1.7 1.7 0 0 0-1.6 1Z"></path>
                    </svg>
                    <span>Ajustes</span>
                </a>
                <form asp-controller="Cuenta" asp-action="Logout" method="post">
                    <button type="submit" class="btn btn-logout">Cerrar sesión</button>
                </form>
            </div>
        </aside>

        <div class="main-panel">
            <header class="topbar">
                <div class="topbar-left">
                    <a class="brand-mini" asp-controller="Home" asp-action="Index">
                        <img src="~/images/quantitary-logo-app.png" alt="Quantitary" class="brand-mini-logo" />
                    </a>
                </div>

                <div class="topbar-right">
                    <button type="button" class="btn btn-icon" aria-label="Notificaciones">
                        <svg class="topbar-icon-svg" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path>
                            <path d="M10 21h4"></path>
                        </svg>
                    </button>
                    <div class="user-pill">
                        <span class="user-avatar-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24">
                                <circle cx="12" cy="8" r="4"></circle>
                                <path d="M4.5 20a7.5 7.5 0 0 1 15 0"></path>
                            </svg>
                        </span>
                        <span>@(Context.Session.GetString("NombreUsuario") ?? "Usuario")</span>
                    </div>
                </div>
            </header>

            <main class="content-area">
                @RenderBody()
            </main>
        </div>
    </div>

    @if (Context.Session.GetInt32("UsuarioID") is > 0)
    {
        <partial name="_AsistenteChat" />
        <script defer src="~/js/quantitary-ia.js" asp-append-version="true"></script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
