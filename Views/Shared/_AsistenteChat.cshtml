@{
  var iaSeccion = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "home").ToLowerInvariant();
  var iaAccion = (ViewContext.RouteData.Values["action"]?.ToString() ?? "index").ToLowerInvariant();
}
<div id="quantitary-ia" aria-label="Quantitary IA" data-section="@iaSeccion" data-action="@iaAccion">
  <button id="robotButton" class="robot-button" type="button" aria-label="Abrir Quantitary IA" aria-expanded="false">
    <img id="robotIcon" src="~/ia/assets/quantitary-ia-normal.svg" alt="" />
  </button>

  <div id="assistantBackdrop" class="ia-backdrop" aria-hidden="true"></div>

  <section id="chatPanel" class="chat-panel" aria-label="Panel de Quantitary IA">
    <aside id="chatHistoryPanel" class="ia-history" aria-label="Historial de conversaciones" hidden>
      <div class="ia-history-header">
        <div class="ia-history-brand">
          <img src="~/ia/assets/quantitary-ia-active.svg" alt="" />
          <div>
            <strong>Quantitary IA</strong>
            <small>Tus conversaciones</small>
          </div>
        </div>
        <button id="historyClose" class="history-close" type="button" aria-label="Cerrar historial">×</button>
      </div>

      <div class="ia-history-content">
        <button id="historyNewChatButton" class="history-new-chat" type="button">
          <span aria-hidden="true">＋</span> Nuevo chat
        </button>
        <label class="history-search">
          <span aria-hidden="true">⌕</span>
          <input id="historySearch" type="search" placeholder="Buscar en tus chats" autocomplete="off" />
        </label>
        <span class="history-section-label">Conversaciones recientes</span>
        <div id="chatHistoryList" class="ia-history-list"></div>
      </div>
    </aside>

    <div class="ia-chat-main">
      <header class="chat-header">
        <img src="~/ia/assets/quantitary-ia-active.svg" alt="">
        <div class="chat-heading">
          <strong>Quantitary IA</strong>
          <small id="assistantStatus" role="status" aria-live="polite">Tu asistente inteligente</small>
        </div>
        <div class="header-actions">
          <button class="icon-button" id="chatsButton" type="button" aria-label="Ver chats" title="Tus chats">☷</button>
          <button class="icon-button" id="newChatButton" type="button" aria-label="Nuevo chat" title="Nuevo chat">＋</button>
          <button class="icon-button desktop-action" id="minimizeButton" type="button" aria-label="Minimizar" title="Minimizar">−</button>
          <button class="icon-button" id="fullscreenButton" type="button" aria-label="Agrandar" aria-pressed="false" title="Agrandar">⛶</button>
          <button class="icon-button" id="closeButton" type="button" aria-label="Cerrar" title="Cerrar">×</button>
        </div>
      </header>

      <div class="chat-body">
        <div id="messages" class="messages" role="log" aria-label="Conversación"></div>
      </div>

      <footer class="chat-footer">
        <div id="attachmentPreview" class="attachment-preview" hidden>
          <img id="attachmentThumbnail" alt="Vista previa del archivo" />
          <div><strong id="attachmentName"></strong><small id="attachmentMeta"></small></div>
          <button id="removeAttachment" type="button" aria-label="Quitar imagen">×</button>
        </div>
        <form id="chatForm" class="input-row" autocomplete="off">
          @Html.AntiForgeryToken()
          <input id="chatImageInput" type="file" accept="image/jpeg,image/png,image/webp" hidden />
          <textarea id="chatInput" rows="1" maxlength="2000" placeholder="Preguntale algo a Quantitary..." aria-label="Escribí tu pregunta"></textarea>
          <button class="attach" id="attachButton" type="button" aria-label="Adjuntar imagen" title="Adjuntar imagen">＋</button>
          <button class="send" id="sendButton" type="submit" aria-label="Enviar" disabled>↗</button>
        </form>
        <small class="attachment-help">JPG, PNG o WebP · máximo 1600 px</small>
      </footer>
    </div>
  </section>

  <div id="chatDialog" class="ia-dialog-backdrop" hidden>
    <section class="ia-dialog" role="dialog" aria-modal="true" aria-labelledby="chatDialogTitle">
      <h3 id="chatDialogTitle"></h3>
      <p id="chatDialogText"></p>
      <input id="chatDialogInput" type="text" maxlength="120" hidden />
      <div class="ia-dialog-actions">
        <button id="chatDialogCancel" type="button" class="secondary">Cancelar</button>
        <button id="chatDialogConfirm" type="button">Confirmar</button>
      </div>
    </section>
  </div>
</div>
