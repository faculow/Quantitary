@{
    ViewData["Title"] = "Importar productos desde Excel";
}

<div class="panel">
    <h2>Importar catálogo desde Excel</h2>

    <div class="alert alert-info">
        <strong>Formato esperado:</strong> el archivo debe tener en la primera fila los encabezados:<br />
        Nombre, SKU, Categoria, Precio, Proveedor
    </div>

    <div class="mb-3">
        <a asp-controller="Stock" asp-action="DescargarPlantillaProductos" class="btn btn-primary">
            Descargar Excel vacío
        </a>
    </div>

    <form asp-action="Importar" method="post" enctype="multipart/form-data" class="row g-3">
        <div class="col-md-8">
            <label class="form-label">Archivo Excel</label>
            <input type="file" name="archivo" class="form-control" accept=".xlsx,.xls" required />
        </div>

        <div class="col-md-4 d-flex align-items-end">
            <button type="submit" class="btn btn-success w-100">Importar</button>
        </div>
    </form>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-secondary">Volver a stock</a>
    </div>
</div>
