@model List<Quantitary.Models.Producto>
@{
    ViewData["Title"] = "Actualizar stock";
    var categorias = ViewBag.Categorias as List<string> ?? new List<string>();
    var ordenSeleccionado = ViewBag.Orden as string ?? "nombre_asc";
}

<div class="panel">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Actualizar stock</h2>
        <div class="d-flex gap-2">
            <a class="btn btn-primary" asp-action="Crear">Agregar producto</a>
            <a class="btn btn-outline-success" asp-action="Importar">Importar Excel</a>
        </div>
    </div>

    @if (TempData["MensajeExito"] != null)
    {
        <div class="alert alert-success">@TempData["MensajeExito"]</div>
    }

    @if (TempData["MensajeAdvertencia"] != null)
    {
        <div class="alert alert-warning">@TempData["MensajeAdvertencia"]</div>
    }

    @if (TempData["MensajeError"] != null)
    {
        <div class="alert alert-danger">@TempData["MensajeError"]</div>
    }

    <form method="get" class="row g-3 align-items-end mb-4">
        <div class="col-md-3">
            <label class="form-label">Buscar por SKU</label>
            <input type="text" name="sku" value="@ViewBag.Sku" class="form-control" placeholder="Ej: ABC-100" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Categoría</label>
            <select name="categoria" class="form-select">
                <option value="">Todas</option>
                @foreach (var categoria in categorias)
                {
                    if (ViewBag.Categoria != null && ViewBag.Categoria.ToString() == categoria)
                    {
                        <option value="@categoria" selected>@categoria</option>
                    }
                    else
                    {
                        <option value="@categoria">@categoria</option>
                    }
                }
            </select>
        </div>

        <div class="col-md-2">
            <label class="form-label">Precio mínimo</label>
            <input type="number" step="0.01" min="0" name="precioMinimo" value="@ViewBag.PrecioMinimo" class="form-control" placeholder="0" />
        </div>

        <div class="col-md-2">
            <label class="form-label">Orden</label>
            <select name="orden" class="form-select">
                <option value="nombre_asc" selected="@(ordenSeleccionado == "nombre_asc" ? "selected" : null)">Nombre A-Z</option>
                <option value="nombre_desc" selected="@(ordenSeleccionado == "nombre_desc" ? "selected" : null)">Nombre Z-A</option>
                <option value="precio_desc" selected="@(ordenSeleccionado == "precio_desc" ? "selected" : null)">Precio mayor</option>
                <option value="precio_asc" selected="@(ordenSeleccionado == "precio_asc" ? "selected" : null)">Precio menor</option>
                <option value="fecha_nuevo" selected="@(ordenSeleccionado == "fecha_nuevo" ? "selected" : null)">Últimos ingresados</option>
                <option value="fecha_antiguo" selected="@(ordenSeleccionado == "fecha_antiguo" ? "selected" : null)">Primeros ingresados</option>
            </select>
        </div>

        <div class="col-md-2">
            <div class="form-check mt-4">
                <input class="form-check-input" type="checkbox" name="pocoStock" value="true" id="pocoStock" @(ViewBag.PocoStock == true ? "checked" : null) />
                <label class="form-check-label" for="pocoStock">Poco stock</label>
            </div>
        </div>

        <div class="col-md-12 d-flex gap-2">
            <button type="submit" class="btn btn-outline-primary">Aplicar filtros</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </div>
    </form>

    <form asp-action="Importar" method="post" enctype="multipart/form-data" class="row g-2 mb-4">
        <div class="col-md-8">
            <input type="file" name="archivo" class="form-control" accept=".csv,.txt" />
        </div>
        <div class="col-md-4">
            <button class="btn btn-success w-100" type="submit">Cargar catálogo</button>
        </div>
    </form>

    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>SKU</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Proveedor</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var producto in Model)
                    {
                        <tr>
                            <td>@producto.Nombre</td>
                            <td>@producto.Sku</td>
                            <td>@producto.Categoria</td>
                            <td>$@producto.Precio.ToString("N2")</td>
                            <td>
                                @producto.StockActual
                                @if (producto.StockActual <= producto.StockMinimo || producto.StockActual == 0)
                                {
                                    <span class="badge bg-warning text-dark ms-2">Bajo</span>
                                }
                            </td>
                            <td>@producto.Proveedor</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a class="btn btn-sm btn-warning" asp-action="Editar" asp-route-id="@producto.Id">Editar</a>
                                    <form asp-action="Eliminar" method="post">
                                        <input type="hidden" name="id" value="@producto.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger">Eliminar</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted">No se encontraron productos.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
