@model Quantitary.Models.PdvIndexViewModel
@{
    ViewData["Title"] = "Punto de venta";
    var categorias = Model.Categorias ?? new List<string>();
}

<div class="pdv-shell quantitary-page">
    <section class="pdv-left">
        <header class="pdv-page-header">
            <div>
                <p>Punto de venta</p>
                <h2>Venta rápida</h2>
            </div>
            <span class="pdv-open-status"><i></i> Caja abierta</span>
        </header>

        <form asp-action="Index" asp-controller="Pdv" method="get" class="pdv-search">
            <input type="hidden" name="categoria" value="@Model.Categoria" />
            <div class="pdv-search-field">
              
                <input type="text" name="filtro" value="@Model.Filtro" placeholder="Buscar por nombre o código SKU" aria-label="Buscar producto" />
            </div>
            <button type="submit">Buscar</button>
        </form>

        <nav class="pdv-categories" aria-label="Categorías">
            <a asp-action="Index" asp-controller="Pdv" asp-route-filtro="@Model.Filtro" asp-route-categoria="" class="@(string.IsNullOrWhiteSpace(Model.Categoria) ? "active" : "")">Todas</a>
            @foreach (var item in categorias)
            {
                <a asp-action="Index" asp-controller="Pdv" asp-route-filtro="@Model.Filtro" asp-route-categoria="@item" class="@(item == Model.Categoria ? "active" : "")">@item</a>
            }
        </nav>

        @if (TempData["PdvError"] != null)
        {
            <div class="alert alert-danger pdv-alert">@TempData["PdvError"]</div>
        }
        @if (TempData["PdvSuccess"] != null)
        {
            <div class="alert alert-success pdv-alert">@TempData["PdvSuccess"]</div>
        }

        <div class="pdv-grid">
            @if (Model.Productos.Any())
            {
                foreach (var producto in Model.Productos)
                {
                    <article class="product-card">
                        <div class="product-card-top">
                            <span class="product-sku">@producto.Sku</span>
                            <span class="stock-badge @(producto.StockActual <= 0 ? "danger" : producto.StockActual < producto.StockMinimo ? "orange" : producto.StockActual == producto.StockMinimo ? "warning" : "ok")">
                                @producto.StockActual uds.
                            </span>
                        </div>
                        <h5>@producto.Nombre</h5>
                        <div class="product-meta">
                            <span><small>Marca</small><strong>@(string.IsNullOrWhiteSpace(producto.Marca) ? "Sin marca" : producto.Marca)</strong></span>
                            <span><small>Stock mínimo</small><strong>@producto.StockMinimo unidades</strong></span>
                        </div>
                        <div class="product-card-footer">
                            <strong>$@producto.Precio.ToString("N0")</strong>
                            <form id="add-@producto.Id" asp-action="Agregar" asp-controller="Pdv" method="post">
                                <input type="hidden" name="id" value="@producto.Id" />
                                <button type="submit" aria-label="Agregar @producto.Nombre al carrito">+</button>
                            </form>
                        </div>
                    </article>
                }
            }
            else
            {
                <div class="pdv-empty">No se encontraron productos para esta búsqueda.</div>
            }
        </div>
    </section>

    <aside class="pdv-right">
        <header class="pdv-cart-header">
            <div>
                <p>Orden actual</p>
                <h3>Venta actual</h3>
            </div>
            <span>@Model.Carrito.Sum(item => item.Cantidad) productos</span>
        </header>

        <div class="cart-items">
            @if (!Model.Carrito.Any())
            {
                <div class="empty-cart">
                    <span>🛒</span>
                    <strong>Tu carrito está vacío</strong>
                    <small>Agregá productos desde el catálogo.</small>
                </div>
            }
            else
            {
                foreach (var item in Model.Carrito)
                {
                    <div class="cart-item">
                        <div class="cart-item-info">
                            <strong>@item.Nombre</strong>
                            <small>@item.Sku · $@item.PrecioUnitario.ToString("N0") c/u</small>
                        </div>
                        <form asp-action="ActualizarCantidad" asp-controller="Pdv" method="post" class="qty-box">
                            <input type="hidden" name="id" value="@item.ProductoId" />
                            <button type="submit" name="cantidad" value="@(item.Cantidad - 1)" aria-label="Reducir cantidad">−</button>
                            <span>@item.Cantidad</span>
                            <button type="submit" name="cantidad" value="@(item.Cantidad + 1)" aria-label="Aumentar cantidad">+</button>
                        </form>
                        <b>$@((item.PrecioUnitario * item.Cantidad).ToString("N0"))</b>
                    </div>
                }
            }
        </div>

        <form asp-action="Cobrar" asp-controller="Pdv" method="post" class="pdv-checkout">
            @Html.AntiForgeryToken()
            <div class="checkout-summary">
                <span>Subtotal</span>
                <strong>$@Model.TotalCarrito.ToString("N0")</strong>
            </div>
            <label for="metodoPago">Método de pago</label>
            <select id="metodoPago" name="metodoPago" class="form-select">
                <option value="Efectivo">Efectivo</option>
                <option value="Transferencia">Transferencia</option>
                <option value="Tarjeta">Tarjeta</option>
            </select>
            <button type="submit" class="checkout-button" disabled="@(!Model.Carrito.Any())">Cobrar ahora</button>
        </form>
    </aside>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const form = document.querySelector('.pdv-shell form');
            if (form) {
                form.addEventListener('submit', function () {
                    if (document.activeElement && document.activeElement.type === 'submit') {
                        const btn = document.activeElement;
                        btn.disabled = true;
                    }
                });
            }
        });
    </script>
}
